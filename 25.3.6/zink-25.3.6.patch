@@ -0,0 +1,91 @@
+BUILD_TYPE=debugoptimized
+
+BASE_PATH="$(pwd)"
+BUILD_PATH="${BASE_PATH}/xplane/"
+PYTHON_EXECUTABLE="python"
+
+case "$(uname -s)" in
+	Linux)
+		BUILD_TYPE=release
+		;;
+	MINGW*)
+		;;
+	*)
+		echo "Unknown target platform $(uname -s)"
+		;;
+esac
+
+build_mesa()
+{
+	meson setup "${BUILD_PATH}/build64" --libdir lib64 --prefix "${BUILD_PATH}/build64/bin" -Dunversion-libgallium=true -Dglvnd=disabled -Degl=disabled -Dgles1=disabled -Dgles2=disabled -Dgbm=disabled -Dgallium-drivers=zink -Dvulkan-drivers= -Dbuildtype=${BUILD_TYPE}
+	ninja -C "${BUILD_PATH}/build64"
+	ninja -C "${BUILD_PATH}/build64" install
+}
+
+build_linux()
+{
+	build_mesa
+
+	# Copy over the Mesa libraries we just built
+	cp ${BUILD_PATH}/build64/bin/lib64/libGL.so.1.2.0 ${BUILD_PATH}/bin/libGL.so
+	cp ${BUILD_PATH}/build64/bin/lib64/libgallium_dri.so ${BUILD_PATH}/bin/libgallium_dri.so
+
+	# Copy over the support libraries we need to link on other distros
+	cp /lib/x86_64-linux-gnu/libsensors.so.5.0.0 ${BUILD_PATH}/bin/libsensors.so.5
+}
+
+build_windows()
+{
+	OLD_PATH=${PATH}
+
+	# Strip our path a bit, removing /usr/bin and /bin so we don't pick up the GNU linker by accident
+	PATH=$(echo ${PATH} | sed -e 's|:/usr/bin||')
+	PATH=$(echo ${PATH} | sed -e 's|:/bin||')
+	export PATH
+
+	build_mesa
+	
+	# Restore our path so we find the core utils again
+	PATH=${OLD_PATH}
+	export PATH
+
+	cp "${BUILD_PATH}/build64/bin/bin/libgallium_wgl.dll" "${BUILD_PATH}/bin/"
+	cp "${BUILD_PATH}/build64/bin/bin/libgallium_wgl.pdb" "${BUILD_PATH}/bin/"
+
+	cp "${BUILD_PATH}/build64/bin/bin/opengl32.dll" "${BUILD_PATH}/bin/"
+	cp "${BUILD_PATH}/build64/bin/bin/opengl32.pdb" "${BUILD_PATH}/bin/"
+
+	cp "${BUILD_PATH}/build64/bin/bin/z-1.dll" "${BUILD_PATH}/bin/"
+	cp "${BUILD_PATH}/build64/bin/bin/z-1.pdb" "${BUILD_PATH}/bin/"
+}
+
+while test $# -gt 0
+do
+	case "$1" in
+		--debug) BUILD_TYPE=debug
+			;;
+		--clean)
+			rm -rf "${BUILD_PATH}/build64"
+			rm -rf "${BUILD_PATH}/bin"
+			;;
+		*) echo "Unknown option ${1}"
+			;;
+	esac
+
+	shift
+done
+
+mkdir -p "${BUILD_PATH}/bin"
+
+case "$(uname -s)" in
+	Linux)
+		PYTHON_EXECUTABLE="python3"
+		build_linux
+		;;
+	MINGW*)
+		build_windows
+		;;
+	*)
+		echo "Unknown target platform $(uname -s)"
+		;;
+esac
diff --git a/xplane/docker/Dockerfile b/xplane/docker/Dockerfile
new file mode 100644
index 00000000000..dd905bb6fea
--- /dev/null
+++ b/xplane/docker/Dockerfile
@@ -0,0 +1,51 @@
+FROM --platform=linux/amd64 ubuntu:focal
+
+# Just enough stuff to get us limping along...
+RUN apt-get update && apt-get install --no-install-recommends -y \
+    wget \
+    gpg-agent \
+    software-properties-common
+
+# Now we need to get CMake 3.19.2 because apt only goes up to 3.16 on 20.04LTS but our minimum is 3.19.
+RUN wget https://cmake.org/files/v3.19/cmake-3.19.2-Linux-x86_64.sh
+RUN /bin/bash cmake-3.19.2-Linux-x86_64.sh --skip-license --prefix=/usr
+
+# Let's us get access to newer a newer CLANG toolchain than Ubuntu 20.04LTS comes with. It wants 12, we want 13. 
+RUN wget -q https://apt.llvm.org/llvm-snapshot.gpg.key
+RUN apt-key add llvm-snapshot.gpg.key
+RUN add-apt-repository 'deb http://apt.llvm.org/focal/ llvm-toolchain-focal-13 main'
+
+# Install the wayland protocols version we need
+RUN wget http://archive.ubuntu.com/ubuntu/pool/main/w/wayland-protocols/wayland-protocols_1.25-1_all.deb
+RUN apt-get install ./wayland-protocols_1.25-1_all.deb
+
+# Install base stuff
+RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
+    build-essential \
+    ninja-build \
+    gdb \
+    lldb \
+    llvm-13 \
+    clang-13 \
+    libc++-13-dev \
+    libc++abi-13-dev
+
+# Install Mesa Dependencies
+RUN cp /etc/apt/sources.list /etc/apt/sources.list~ && sed -Ei 's/^# deb-src /deb-src /' /etc/apt/sources.list && apt-get update && apt-get build-dep mesa -y
+
+# Upgrade Meson
+RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
+    python3.9 \
+    python3-pip
+
+RUN apt-get remove meson -y
+
+RUN ln -s $(which python3.9) /usr/local/bin/python3
+RUN python3 -m pip install meson
+RUN python3 -m pip install mako
+
+# Create a user so the Docker container is usable in CLion. Build with --build-arg UID=$(id -u)
+ARG UID=1000
+RUN useradd -m -u ${UID} -s /bin/bash builder
+USER builder
+
