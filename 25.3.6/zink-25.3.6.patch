+probe_impl_code = """
+<%namespace name="helpers" file="helpers"/>
+#include <stdalign.h>
+
+struct zink_xplane_probe_result 
+zink_xplane_probe_features(VkPhysicalDevice physical_device, struct zink_xplane_probe_functions *functions, const VkAllocationCallbacks *pAllocator)
+{
+   struct zink_xplane_probe_result probe_result = {};
+
+%for ext in extensions:
+   <%helpers:guard ext="${ext}">
+      bool have_${ext.name_with_vendor()} = false;
+   </%helpers:guard>
+%endfor
+%for version in versions:
+   bool have_vulkan${version.struct()} = false;
+%endfor
+
+%for ext in extensions:
+   <%helpers:guard ext="${ext}">
+         bool support_${ext.name_with_vendor()} = false;
+      %if ext.is_promoted_to_khr:
+         bool support_${ext.name_with_vendor("KHR")} = false; /* promoted from EXT */
+      %endif
+   </%helpers:guard>
+%endfor
+   uint32_t num_extensions = 0;
+
+   // enumerate device supported extensions
+   VkResult result = functions->vkEnumerateDeviceExtensionProperties(physical_device, NULL, &num_extensions, NULL);
+   if (result < VK_SUCCESS)
+   {
+      probe_result.fail_reason = "ZINK: vkEnumerateDeviceExtensionProperties failed";
+      goto fail;
+   }
+
+   if (num_extensions > 0) {
+      VkExtensionProperties *extensions = MALLOC(sizeof(VkExtensionProperties) * num_extensions);
+      if (!extensions) goto fail;
+      result = functions->vkEnumerateDeviceExtensionProperties(physical_device, NULL, &num_extensions, extensions);
+      if (result < VK_SUCCESS)
+      {
+         FREE(extensions);
+
+         probe_result.fail_reason = "ZINK: vkEnumerateDeviceExtensionProperties failed";
+         goto fail;
+      }
+
+      for (uint32_t i = 0; i < num_extensions; ++i) {
+      %for ext in extensions:
+         <%helpers:guard ext="${ext}">
+            %if ext.is_promoted_to_khr:
+               bool promoted_${ext.pure_name()} = !strcmp(extensions[i].extensionName, "${ext.with_vendor("KHR")}");
+               if (!strcmp(extensions[i].extensionName, "${ext.name}") || promoted_${ext.pure_name()}) {
+            %else:
+               if (!strcmp(extensions[i].extensionName, "${ext.name}")) {
+            %endif
+            %if not (ext.has_features or ext.has_properties):
+                  have_${ext.name_with_vendor()} = true;
+            %else:
+                  support_${ext.name_with_vendor()} = true;
+            %endif
+            %if ext.is_promoted_to_khr:
+                  if (promoted_${ext.pure_name()}) {
+                     support_${ext.name_with_vendor("KHR")} = true;
+                  }
+            %endif
+               }
+         </%helpers:guard>
+      %endfor
+      }
+
+      FREE(extensions);
+   }
+
+   // get device features
+   VkPhysicalDeviceFeatures2 feats = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2 };
+   VkPhysicalDeviceProperties2 props = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2 };
+
+%for version in versions:
+   VkPhysicalDeviceVulkan${version.struct()}Features feats${version.struct()} = { ${version.stype("FEATURES")} };
+   VkPhysicalDeviceVulkan${version.struct()}Properties props${version.struct()} =  { ${version.stype("PROPERTIES")} };
+%endfor
+
+%for ext in extensions:
+   <%helpers:guard ext="${ext}">
+      %if ext.has_features:
+         ${ext.physical_device_struct("Features")} ${ext.field("feats")} = { ${ext.stype("FEATURES")} };
+      %endif
+      %if ext.has_properties:
+         ${ext.physical_device_struct("Properties")} ${ext.field("props")} = { ${ext.stype("PROPERTIES")} };
+      %endif
+   </%helpers:guard>
+%endfor
+
+   {
+      // check for device extension features
+%for version in versions:
+   %if version.device_version < (1,2,0):
+         if (VK_MAKE_VERSION(1,2,0) <= functions->vk_version) {
+            /* VkPhysicalDeviceVulkan11Features was added in 1.2, not 1.1 as one would think */
+   %else:
+         if (${version.version()} <= functions->vk_version) {
+   %endif
+            feats${version.struct()}.pNext = feats.pNext;
+            feats.pNext = &feats${version.struct()};
+            have_vulkan${version.struct()} = true;
+         }
+%endfor
+
+%for ext in extensions:
+   %if ext.has_features:
+      <%helpers:guard ext="${ext}">
+         %if ext.features_promoted:
+               if (support_${ext.name_with_vendor()} && !have_vulkan${ext.core_since.struct()}) {
+         %else:
+               if (support_${ext.name_with_vendor()}) {
+         %endif
+                  ${ext.field("feats")}.pNext = feats.pNext;
+                  feats.pNext = &${ext.field("feats")};
+               }
+      </%helpers:guard>
+   %endif
+%endfor
+
+      functions->vkGetPhysicalDeviceFeatures2(physical_device, &feats);
+   }
+
+
+    
+
+    if (functions->vkGetPhysicalDeviceProperties2) {
+%for version in versions:
+   %if version.device_version < (1,2,0):
+         if (VK_MAKE_VERSION(1,2,0) <= functions->vk_version) {
+            /* VkPhysicalDeviceVulkan11Properties was added in 1.2, not 1.1 as one would think */
+   %else:
+         if (${version.version()} <= functions->vk_version) {
+   %endif
+            props${version.struct()}.sType = ${version.stype("PROPERTIES")};
+            props${version.struct()}.pNext = props.pNext;
+            props.pNext = &props${version.struct()};
+         }
+%endfor
+
+%for ext in extensions:
+   %if ext.has_properties:
+      <%helpers:guard ext="${ext}">
+         %if ext.properties_promoted:
+               if (support_${ext.name_with_vendor()} && !have_vulkan${ext.core_since.struct()}) {
+         %else:
+               if (support_${ext.name_with_vendor()}) {
+         %endif
+                  ${ext.field("props")}.pNext = props.pNext;
+                  props.pNext = &${ext.field("props")};
+               }
+      </%helpers:guard>
+   %endif
+%endfor
+
+      functions->vkGetPhysicalDeviceProperties2(physical_device, &props);
+   }
+
+
+   /* We re-apply the fields from VkPhysicalDeviceVulkanXYFeatures struct
+    * onto their respective fields in the VkPhysicalDeviceExtensionNameFeatures
+    * struct if the former is provided by the VK implementation.
+    *
+    * As for why this is done: the spec mentions that once an extension is
+    * promoted to core and its feature fields are added in VulkanXYFeatures,
+    * including both ExtensionNameFeatures and VulkanXYFeatures at the same
+    * time is prohibited when using vkGetPhysicalDeviceFeatures2.
+    */
+%for ext in extensions:
+   %if ext.features_promoted:
+      if (have_vulkan${ext.core_since.struct()}) {
+      %for field in registry.get_registry_entry(ext.name).features_fields:
+         ${ext.field("feats")}.${field} = feats${ext.core_since.struct()}.${field};
+      %endfor
+      }
+   %endif
+%endfor
+
+   /* See above, but for VulkanXYProperties.
+    * Unlike VulkanXYFeatures with all the booleans, VulkanXYProperties can
+    * contain different types of data, including arrays. The C language hates us
+    * when we assign an array to another array, therefore we use an memcpy here.
+    */
+%for ext in extensions:
+   %if ext.properties_promoted:
+      if (have_vulkan${ext.core_since.struct()}) {
+      %for field in registry.get_registry_entry(ext.name).properties_fields:
+         memcpy(&${ext.field("props")}.${field.name},
+               &props${ext.core_since.struct()}.${field.name},
+               sizeof(${ext.field("props")}.${field.name}));
+      %endfor
+      }
+   %endif
+%endfor
+
+   // enable the extensions if they match the conditions given by ext.enable_conds 
+   if (functions->vkGetPhysicalDeviceProperties2) {
+        %for ext in extensions:
+<%helpers:guard ext="${ext}">
+<%
+    conditions = ""
+    if ext.enable_conds:
+        for cond in ext.enable_conds:
+            cond = cond.replace("$feats", ext.field("feats"))
+            cond = cond.replace("$props", ext.field("props"))
+            conditions += "&& (" + cond + ")\\n"
+    conditions = conditions.strip()
+%>\
+      have_${ext.name_with_vendor()} |= support_${ext.name_with_vendor()}
+         ${conditions};
+</%helpers:guard>
+        %endfor
+   }
+
+   // generate extension list
+   const char **extensions = MALLOC(${len(extensions)} * sizeof(const char *));
+   num_extensions = 0;
+
+%for ext in extensions:
+   <%helpers:guard ext="${ext}">
+         if (have_${ext.name_with_vendor()}) {
+      %if ext.is_promoted_to_khr:
+            if (support_${ext.name_with_vendor("KHR")})
+               extensions[num_extensions++] = "${ext.with_vendor("KHR")}";
+            else
+               extensions[num_extensions++] = "${ext.name}";
+      %else:
+            extensions[num_extensions++] = "${ext.name}";
+      %endif
+      %if ext.is_required:
+         } else {
+            probe_result.fail_reason = "ZINK: ${ext.name} required!";
+            goto fail;
+      %endif
+         }
+   </%helpers:guard>
+%endfor
+   
+   const char **ext_array = (const char **)pAllocator->pfnAllocation(pAllocator->pUserData, sizeof(const char *) * num_extensions, alignof(const char *), VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   memcpy(ext_array, extensions, sizeof(const char *) * num_extensions);
+
+   FREE(extensions);
+
+   probe_result.num_extensions = num_extensions;
+   probe_result.extensions = ext_array;
+   
+   
+   // Generate the features list
+   VkBaseOutStructure **features = MALLOC(${len(extensions) + len(versions)} * sizeof(VkBaseOutStructure *));
+   uint32_t num_features = 0;
+
+%for version in versions:
+   %if version.device_version < (1,2,0):
+         if (VK_MAKE_VERSION(1,2,0) <= functions->vk_version) {
+            /* VkPhysicalDeviceVulkan11Features was added in 1.2, not 1.1 as one would think */
+   %else:
+         if (${version.version()} <= functions->vk_version) {
+   %endif
+            VkPhysicalDeviceVulkan${version.struct()}Features *feature = (VkPhysicalDeviceVulkan${version.struct()}Features *)pAllocator->pfnAllocation(pAllocator->pUserData, sizeof(VkPhysicalDeviceVulkan${version.struct()}Features), alignof(VkPhysicalDeviceVulkan${version.struct()}Features), VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+            *feature = feats${version.struct()};
+            feature->pNext = NULL;
+
+            features[num_features ++] = (VkBaseOutStructure *)feature;
+         }
+%endfor
+
+%for ext in extensions:
+   %if ext.has_features:
+      <%helpers:guard ext="${ext}">
+         %if ext.features_promoted:
+               if (have_${ext.name_with_vendor()} && !have_vulkan${ext.core_since.struct()}) {
+         %else:
+               if (have_${ext.name_with_vendor()}) {
+         %endif
+                  ${ext.physical_device_struct("Features")} *feature = (${ext.physical_device_struct("Features")} *)pAllocator->pfnAllocation(pAllocator->pUserData, sizeof(${ext.physical_device_struct("Features")}), alignof(${ext.physical_device_struct("Features")}), VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+                  *feature = ${ext.field("feats")};
+                  feature->pNext = NULL;
+
+                  features[num_features ++] = (VkBaseOutStructure *)feature;
+               }
+      </%helpers:guard>
+   %endif
+%endfor
+
+   VkBaseOutStructure **feat_array = (VkBaseOutStructure **)pAllocator->pfnAllocation(pAllocator->pUserData, sizeof(VkBaseOutStructure *) * num_features, alignof(VkBaseOutStructure *), VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   memcpy(feat_array, features, sizeof(VkBaseOutStructure *) * num_features);
+
+   FREE(features);
+
+   probe_result.num_features = num_features;
+   probe_result.features = feat_array;
+
+   probe_result.can_run = true;
+   return probe_result;
+
+fail:
+
+   probe_result.can_run = false;
+   return probe_result;
+}
